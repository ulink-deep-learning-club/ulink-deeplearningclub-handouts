msgid "PyTorch实现示例"
msgstr "PyTorch Implementation Example"

#: ../../../source/math-fundamentals/loss-functions.md:290
msgid ""
"import torch\n"
"import torch.nn as nn\n"
"\n"
"# 回归损失\n"
"mse_loss = nn.MSELoss()\n"
"mae_loss = nn.L1Loss()  # MAE\n"
"huber_loss = nn.SmoothL1Loss(beta=1.0)\n"
"\n"
"# 分类损失\n"
"ce_loss = nn.CrossEntropyLoss()  # 包含softmax\n"
"bce_loss = nn.BCELoss()  # 二分类，需手动sigmoid\n"
"kl_loss = nn.KLDivLoss(reduction='batchmean')\n"
"\n"
"# 使用示例\n"
"predictions = model(inputs)\n"
"loss = ce_loss(predictions, targets)  # 多分类\n"
"loss.backward()  # 计算梯度\n"
msgstr ""
"import torch\n"
"import torch.nn as nn\n"
"\n"
"# Regression losses\n"
"mse_loss = nn.MSELoss()\n"
"mae_loss = nn.L1Loss()  # MAE\n"
"huber_loss = nn.SmoothL1Loss(beta=1.0)\n"
"\n"
"# Classification losses\n"
"ce_loss = nn.CrossEntropyLoss()  # includes softmax\n"
"bce_loss = nn.BCELoss()  # binary classification, requires manual sigmoid\n"
"kl_loss = nn.KLDivLoss(reduction='batchmean')\n"
"\n"
"# Usage example\n"
"predictions = model(inputs)\n"
"loss = ce_loss(predictions, targets)  # multi-class classification\n"
"loss.backward()  # compute gradients\n"

