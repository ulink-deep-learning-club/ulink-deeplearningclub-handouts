#: ../../../source/math-fundamentals/the-end.md:41
msgid "框架自动完成，理解即可"
msgstr "Handled automatically by frameworks; conceptual understanding suffices"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "梯度下降"
msgstr "Gradient Descent"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "下山策略"
msgstr "Downhill strategy"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "默认Adam，大模型用Warmup+Cosine"
msgstr "Default to Adam; use Warmup + Cosine decay for large models"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "学习率"
msgstr "Learning Rate"

#: ../../../source/math-fundamentals/the-end.md:41
