msgstr "Shapes optimization landscape"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "分类用交叉熵，回归用MSE/MAE"
msgstr "Use cross-entropy for classification, MSE/MAE for regression"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "反向传播"
msgstr "Backpropagation"

#: ../../../source/math-fundamentals/the-end.md:41
msgid "信用分配"
