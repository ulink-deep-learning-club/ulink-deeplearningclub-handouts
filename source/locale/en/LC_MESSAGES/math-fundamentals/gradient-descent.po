msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:210
msgid "梯度的\"平均趋势\"，平滑后的梯度方向"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:210
msgid "$\\beta_1$"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:210
msgid "一阶矩衰减率"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:210
msgid "通常是 0.9，保留 90% 历史信息"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:210
#, python-brace-format
msgid "$m_{t-1}$"
