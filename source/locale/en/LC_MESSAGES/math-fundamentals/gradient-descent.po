#: ../../../source/math-fundamentals/gradient-descent.md:601
msgid "1. 步长衰减（Step Decay）"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:603
msgid "**策略**：每N个epoch，学习率乘以衰减系数（如0.1）"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:605
#: ../../../source/math-fundamentals/gradient-descent.md:623
#: ../../../source/math-fundamentals/gradient-descent.md:639
msgid "**适用场景**："
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:607
msgid "传统图像分类任务（ImageNet训练标配）"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:608
msgid "当验证集损失不再下降时手动降低学习率"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:610
msgid ""
"# 每30个epoch，学习率乘以0.1\n"
"scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=30, gamma=0.1)"
"\n"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:615
msgid "**特点**：阶梯式下降，简单有效，但需要预设衰减时机。"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:617
msgid "2. 指数衰减（Exponential Decay）"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:619
msgid "**策略**：每个epoch学习率按指数衰减"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:621
msgid "\\eta_t = \\eta_0 \\cdot \\gamma^t"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:625
msgid "需要平滑连续衰减"
