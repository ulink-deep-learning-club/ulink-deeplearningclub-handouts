#: ../../../source/math-fundamentals/gradient-descent.md:407
#, python-brace-format
msgid ""
"\n"
"\\hat{m}_t = \\frac{m_t}{1-\\beta_1^t}, \\quad \\hat{v}_t = "
"\\frac{v_t}{1-\\beta_2^t}\n"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:411
msgid "**为什么需要修正？**"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:413
