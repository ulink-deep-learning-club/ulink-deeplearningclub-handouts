#: ../../../source/math-fundamentals/gradient-descent.md:628
msgid ""
"# 每个epoch学习率乘以0.95\n"
"scheduler = optim.lr_scheduler.ExponentialLR(optimizer, gamma=0.95)\n"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:633
msgid "3. 余弦退火（Cosine Annealing）"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:635
msgid "**策略**：学习率按余弦函数从初始值降到接近0"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:637
msgid ""
"\\eta_t = \\eta_{min} + \\frac{1}{2}(\\eta_{max} - \\eta_{min})(1 + "
"\\cos(\\frac{t}{T_{max}}\\pi))"
msgstr ""

#: ../../../source/math-fundamentals/gradient-descent.md:641
msgid "现代Transformer模型（BERT、GPT等）"
