#: ../../../source/pytorch-practice/optimiser.md:23
#, python-brace-format
msgid ""
"\n"
"\\theta_{t+1} = \\theta_t - \\eta \\cdot \\nabla_\\theta J(\\theta)\n"
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:27
msgid "**含义**：新参数 = 当前参数 - 学习率 × 梯度"
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:29
msgid "**PyTorch 实现**："
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:31
msgid ""
"import torch\n"
"import torch.nn as nn\n"
"import torch.optim as optim\n"
"\n"
"# 定义模型\n"
"model = nn.Linear(10, 1)\n"
"\n"
"# 创建优化器\n"
"optimizer = optim.SGD(\n"
"    model.parameters(),    # 要优化的参数\n"
"    lr=0.01               # 学习率 η\n"
")\n"
"\n"
"# 训练循环\n"
"for epoch in range(100):\n"
"    optimizer.zero_grad()      # 1. 清零梯度\n"
"    output = model(input_data) # 2. 前向传播\n"
"    loss = criterion(output, target)\n"
"    loss.backward()            # 3. 反向传播\n"
"    optimizer.step()           # 4. 更新参数（执行 θ = θ - lr * grad）\n"
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:54
msgid "Momentum：加速收敛"
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:56
#: ../../../source/pytorch-practice/optimiser.md:101
msgid "理论回顾"
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:58
#, python-brace-format
msgid "{ref}`gradient-descent`中的 Momentum 引入\"速度\"概念："
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:60
#, python-brace-format
msgid ""
"\n"
"v_{t+1} = \\gamma v_t + \\nabla_\\theta J(\\theta_t) \\\\\n"
"\\theta_{t+1} = \\theta_t - \\eta \\cdot v_{t+1}\n"
msgstr ""

#: ../../../source/pytorch-practice/optimiser.md:65
msgid "**核心思想**：新速度 = 保留的原有速度 + 新梯度，用速度代替直接梯度更新参数。"
msgstr ""

