#: ../../../source/pytorch-practice/tensor-ops.md:152
msgid "transpose 与 permute：重排维度顺序"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:154
msgid "**直觉**：想象一个魔方，你可以旋转它的面——元素位置改变，但数据不变。"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:156
#, python-brace-format
msgid ""
"# 原始：[batch, channels, height, width] —— PyTorch 默认格式\n"
"x = torch.randn(2, 3, 4, 5)\n"
"print(f\"原始: {x.shape}\")  # torch.Size([2, 3, 4, 5])\n"
"\n"
"# transpose：交换两个维度\n"
"y = x.transpose(1, 2)  # 交换 channels 和 height\n"
"print(f\"transpose: {y.shape}\")  # torch.Size([2, 4, 3, 5])\n"
"\n"
"# permute：任意重排所有维度\n"
"z = x.permute(0, 2, 3, 1)  # [batch, height, width, channels]\n"
"print(f\"permute: {z.shape}\")  # torch.Size([2, 4, 5, 3])\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:170
msgid "**实际应用：图像格式转换**"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:172
#, python-brace-format
msgid ""
"# OpenCV 读取的图片是 [H, W, C]（通道在最后）\n"
"opencv_image = torch.randn(224, 224, 3)\n"
"\n"
"# 转换为 PyTorch 格式 [C, H, W]（通道在最前）\n"
"pytorch_image = opencv_image.permute(2, 0, 1)\n"
"print(f\"PyTorch 格式: {pytorch_image.shape}\")  # torch.Size([3, 224, "
"224])\n"
msgstr ""

