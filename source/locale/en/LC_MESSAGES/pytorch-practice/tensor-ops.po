#: ../../../source/pytorch-practice/tensor-ops.md:355
msgid "视图 vs 复制"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:357
msgid ""
"x = torch.randn(2, 3, 4)\n"
"\n"
"# view/reshape：共享内存（视图）\n"
"y = x.view(6, 4)\n"
"y[0, 0] = 999\n"
"print(x[0, 0, 0])  # 999 —— x 也被修改了！\n"
"\n"
"# clone()：创建副本\n"
"z = x.clone().view(6, 4)\n"
"z[0, 0] = 888\n"
"print(x[0, 0, 0])  # 999 —— x 不受影响\n"
msgstr ""

