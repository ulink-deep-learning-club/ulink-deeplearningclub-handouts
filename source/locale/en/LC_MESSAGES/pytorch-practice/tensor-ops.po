msgid "contiguous：内存连续性"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:382
msgid ""
"x = torch.randn(2, 3, 4)\n"
"\n"
"# transpose 后张量可能不连续\n"
"y = x.transpose(0, 1)  # shape: [3, 2, 4]\n"
"print(y.is_contiguous())  # False\n"
"\n"
"# view 要求连续内存，会报错\n"
"# z = y.view(6, 4)  # RuntimeError!\n"
"\n"
"# 方法 1：先 contiguous\n"
"z = y.contiguous().view(6, 4)\n"
"\n"
"# 方法 2：直接用 reshape（自动处理）\n"
"z = y.reshape(6, 4)\n"
msgstr ""

