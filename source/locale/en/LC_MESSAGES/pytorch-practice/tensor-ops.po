#: ../../../source/pytorch-practice/tensor-ops.md:183
#, python-brace-format
msgid ""
"# 卷积层输出：[batch, 32, 7, 7]\n"
"conv_out = torch.randn(64, 32, 7, 7)\n"
"\n"
"# flatten：从指定维度开始展平\n"
"fc_input = conv_out.flatten(start_dim=1)  # 保持 batch，展平后面所有维度\n"
"print(f\"flatten: {fc_input.shape}\")  # torch.Size([64, 1568])\n"
"\n"
"# 等价于\n"
"fc_input = conv_out.reshape(64, -1)\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:195
msgid "广播机制：让不同形状的张量一起运算"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:197
msgid "什么是广播？"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:199
msgid "**直觉**：广播就像班级合影——小个子站在凳子上，大个子弯下腰，最终大家的脸在同一水平线上。"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:201
msgid ""
"# 场景 1：张量 + 标量\n"
"x = torch.tensor([[1, 2], [3, 4]])\n"
"y = x + 10  # 标量 10 被\"广播\"为 [[10, 10], [10, 10]]\n"
"print(y)\n"
"# tensor([[11, 12],\n"
"#         [13, 14]])\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:210
msgid "**广播规则**（从右到左比较维度）："
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:211
msgid "维度相等：可以广播"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:212
msgid "其中一个为 1：可以广播（复制该维度）"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:213
msgid "都不为 1 且不相等：**不能广播**"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:215
msgid "**广播可视化**："
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:219
msgid "广播机制示意图"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:274
msgid "广播示例"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:276
#, python-brace-format
msgid ""
"# 场景 2：不同形状但兼容\n"
"# A: [3, 1] —— 3 行 1 列\n"
"# B: [1, 4] —— 1 行 4 列\n"
"A = torch.tensor([[1], [2], [3]])  # shape: [3, 1]\n"
"B = torch.tensor([[10, 20, 30, 40]])  # shape: [1, 4]\n"
"\n"
"# A 被广播为 [3, 4]：复制列\n"
"# B 被广播为 [3, 4]：复制行\n"
"C = A + B\n"
"print(f\"C 的形状: {C.shape}\")  # torch.Size([3, 4])\n"
"print(C)\n"
"# tensor([[11, 21, 31, 41],\n"
"#         [12, 22, 32, 42],\n"
"#         [13, 23, 33, 43]])\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:293
msgid "神经网络中的广播应用"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:295
#, python-brace-format
msgid ""
"# 批归一化中的均值减法\n"
"batch_data = torch.randn(64, 3, 224, 224)  # batch=64, 3通道\n"
"\n"
"# 计算每个通道的均值：[3] —— 每个通道一个均值\n"
"channel_mean = batch_data.mean(dim=[0, 2, 3])  # 在 batch、height、width "
"上求平均\n"
"print(f\"通道均值形状: {channel_mean.shape}\")  # torch.Size([3])\n"
"\n"
"# 广播减法：channel_mean [3] → 自动广播为 [64, 3, 224, 224]\n"
"normalized = batch_data - channel_mean.view(1, 3, 1, 1)\n"
"print(f\"归一化后: {normalized.shape}\")  # torch.Size([64, 3, 224, 224])\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:308
msgid "索引与切片：精准定位数据"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:310
msgid "基本索引"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:312
msgid ""
"x = torch.randn(4, 5, 6)  # 类比：4 张图片，每张 5×6\n"
"\n"
"# 取第一张图片\n"
"first = x[0]  # shape: [5, 6]\n"
"\n"
"# 取所有图片的第 0 行\n"
"first_row = x[:, 0]  # shape: [4, 6]\n"
"\n"
"# 取子张量\n"
"patch = x[1:3, 2:4, :]  # shape: [2, 2, 6]\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:325
msgid "高级索引"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:327
msgid ""
"# 用索引张量选取\n"
"x = torch.randn(5, 3)\n"
"indices = torch.tensor([0, 2, 4])  # 选第 0、2、4 行\n"
"selected = x[indices]  # shape: [3, 3]\n"
"\n"
"# 布尔掩码\n"
"mask = x > 0\n"
"positive = x[mask]  # 一维张量，包含所有正数\n"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:338
msgid "gather 与 scatter：复杂数据重排"
msgstr ""

#: ../../../source/pytorch-practice/tensor-ops.md:340
msgid ""
"# gather：按索引收集数据\n"
"src = torch.tensor([[1, 2], [3, 4], [5, 6]])  # [3, 2]\n"
"index = torch.tensor([[0, 0], [1, 0], [0, 1]])  # [3, 2]\n"
"\n"
"# 按 index 从 src 中收集\n"
"dst = torch.gather(src, 1, index)\n"
"print(dst)\n"
"# tensor([[1, 1],   # 第0行取 src[0,0], src[0,0]\n"
"#         [4, 3],   # 第1行取 src[1,1], src[1,0]\n"
"#         [5, 6]])  # 第2行取 src[2,0], src[2,1]\n"
msgstr ""

