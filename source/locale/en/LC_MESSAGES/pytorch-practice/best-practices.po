#: ../../../source/pytorch-practice/best-practices.md:501
msgid "混合精度训练"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:503
msgid "现代 GPU（V100及以上）支持 Tensor Cores，使用混合精度可以加速2-3倍："
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:505
msgid ""
"from torch.cuda.amp import autocast, GradScaler\n"
"\n"
"# 初始化梯度缩放器（处理梯度下溢）\n"
"scaler = GradScaler()\n"
"\n"
"for data, target in train_loader:\n"
"    data, target = data.to(device), target.to(device)\n"
"    optimizer.zero_grad()\n"
"    \n"
"    # 使用autocast自动选择精度（FP16/FP32）\n"
"    with autocast():\n"
"        output = model(data)\n"
"        loss = criterion(output, target)\n"
"    \n"
"    # 缩放梯度避免下溢，然后反向传播\n"
"    scaler.scale(loss).backward()\n"
"    \n"
"    # 梯度裁剪（如果需要）\n"
"    scaler.unscale_(optimizer)\n"
"    torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n"
"    \n"
"    # 更新参数\n"
"    scaler.step(optimizer)\n"
"    scaler.update()\n"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:532
msgid "**原理**："
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:533
msgid "FP16（半精度）：占内存少、计算快，但范围小容易溢出"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:534
msgid "FP32（单精度）：范围大、精度高，但计算慢"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:535
msgid "**混合精度**：前向/反向用FP16，参数更新用FP32，兼顾速度和稳定性"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:537
msgid "梯度累积"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:539
msgid "当GPU内存不足以支持大批量时，使用梯度累积："
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:541
#, python-brace-format
msgid ""
"accumulation_steps = 4  # 累积4个batch再更新\n"
"\n"
"for batch_idx, (data, target) in enumerate(train_loader):\n"
"    data, target = data.to(device), target.to(device)\n"
"    \n"
"    # 前向传播\n"
"    output = model(data)\n"
"    \n"
"    # 损失除以累积步数（保证梯度大小一致）\n"
"    loss = criterion(output, target) / accumulation_steps\n"
"    loss.backward()\n"
"    \n"
"    # 每accumulation_steps步更新一次参数\n"
"    if (batch_idx + 1) % accumulation_steps == 0:\n"
"        optimizer.step()\n"
"        optimizer.zero_grad()\n"
"        \n"
"        print(f\"更新参数: batch {batch_idx}\")\n"
"\n"
"# 处理最后不足一个累积周期的梯度\n"
"if (batch_idx + 1) % accumulation_steps != 0:\n"
"    optimizer.step()\n"
"    optimizer.zero_grad()\n"
msgstr ""

#: ../../../source/pytorch-practice/best-practices.md:567
msgid "**效果**：batch_size=16，accumulation_steps=4，等效batch_size=64"
msgstr ""

