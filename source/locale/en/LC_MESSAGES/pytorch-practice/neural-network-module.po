msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:346
msgid "参数初始化"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:348
msgid "良好的初始化对训练很重要:"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:350
msgid ""
"def initialize_weights(m):\n"
"    \"\"\"自定义初始化\"\"\"\n"
"    if isinstance(m, nn.Linear):\n"
"        # Xavier 初始化（适合 tanh/sigmoid）\n"
"        nn.init.xavier_uniform_(m.weight)\n"
"        nn.init.zeros_(m.bias)\n"
"    elif isinstance(m, nn.Conv2d):\n"
"        # He 初始化（适合 ReLU）\n"
"        nn.init.kaiming_normal_(m.weight, mode='fan_out', "
"nonlinearity='relu')\n"
"        nn.init.zeros_(m.bias)\n"
"\n"
"# 应用到整个模型\n"
"model.apply(initialize_weights)\n"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:366
msgid "冻结参数"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:368
msgid "迁移学习中，常常需要冻结预训练层的参数："
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:370
#, python-brace-format
msgid ""
"# 冻结卷积层，只训练全连接层\n"
"for param in model.c1.parameters():\n"
"    param.requires_grad = False\n"
"\n"
"for param in model.c3.parameters():\n"
"    param.requires_grad = False\n"
"\n"
"# 验证\n"
"for name, param in model.named_parameters():\n"
"    print(f\"{name}: requires_grad={param.requires_grad}\")\n"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:383
msgid "常见层详解"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:385
msgid "激活函数层"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:387
msgid ""
"# ReLU（最常用）\n"
"relu = nn.ReLU()  # max(0, x)\n"
"\n"
"# Sigmoid（二分类输出）\n"
"sigmoid = nn.Sigmoid()  # 1 / (1 + exp(-x))\n"
"\n"
"# Tanh（早期网络）\n"
"tanh = nn.Tanh()\n"
"\n"
"# Softmax（多分类输出）\n"
"softmax = nn.Softmax(dim=1)  # 沿类别维度\n"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:401
msgid "归一化层"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:403
msgid ""
"# BatchNorm（最常用）\n"
"bn = nn.BatchNorm2d(num_features=64)  # 对64个通道分别归一化\n"
"\n"
"# LayerNorm（适合序列数据）\n"
"ln = nn.LayerNorm(normalized_shape=[64, 28, 28])\n"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:411
msgid "正则化层"
