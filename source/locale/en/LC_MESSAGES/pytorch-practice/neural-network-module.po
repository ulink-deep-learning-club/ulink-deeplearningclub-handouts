msgid ""
"# Dropout（防止过拟合）\n"
"dropout = nn.Dropout(p=0.5)  # 50%概率丢弃\n"
"\n"
"# 注意：训练时生效，推理时自动关闭（model.eval()）\n"
msgstr ""

