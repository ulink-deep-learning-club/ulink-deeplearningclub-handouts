#: ../../../source/pytorch-practice/neural-network-module.md:271
msgid "容器：组织多个层"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:273
msgid "nn.Sequential：顺序执行"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:275
msgid "当层按顺序连接时，用 `nn.Sequential` 简化代码："
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:277
msgid ""
"# 方式1：逐个添加\n"
"model = nn.Sequential(\n"
"    nn.Linear(784, 256),\n"
"    nn.ReLU(),\n"
"    nn.Dropout(0.2),\n"
"    nn.Linear(256, 10)\n"
")\n"
"\n"
"# 方式2：带名称（便于访问）\n"
"from collections import OrderedDict\n"
"\n"
"model = nn.Sequential(OrderedDict([\n"
"    ('fc1', nn.Linear(784, 256)),\n"
"    ('relu1', nn.ReLU()),\n"
"    ('dropout', nn.Dropout(0.2)),\n"
"    ('fc2', nn.Linear(256, 10))\n"
"]))\n"
"\n"
"# 访问特定层\n"
"print(model.fc1)  # 或 model[0]\n"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:300
msgid "nn.ModuleList：动态层数"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:302
msgid "当层数不固定（如根据配置决定深度）时使用："
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:304
msgid ""
"class DynamicNet(nn.Module):\n"
"    def __init__(self, layer_sizes):\n"
"        super(DynamicNet, self).__init__()\n"
"        \n"
"        self.layers = nn.ModuleList()\n"
"        for i in range(len(layer_sizes) - 1):\n"
"            self.layers.append(nn.Linear(layer_sizes[i], "
"layer_sizes[i+1]))\n"
"            if i < len(layer_sizes) - 2:  # 最后一层不加激活\n"
"                self.layers.append(nn.ReLU())\n"
"    \n"
"    def forward(self, x):\n"
"        for layer in self.layers:\n"
"            x = layer(x)\n"
"        return x\n"
"\n"
"# 使用\n"
"model = DynamicNet([784, 256, 128, 64, 10])\n"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:324
msgid "参数管理"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:326
msgid "查看和访问参数"
msgstr ""

#: ../../../source/pytorch-practice/neural-network-module.md:328
#, python-brace-format
msgid ""
"model = LeNet5()\n"
"\n"
"# 查看所有参数\n"
"for name, param in model.named_parameters():\n"
"    print(f\"{name}: {param.shape} ({param.numel()} 参数)\")\n"
"\n"
"# 输出示例：\n"
