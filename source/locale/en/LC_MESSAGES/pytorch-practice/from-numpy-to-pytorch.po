#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:230
msgid "完整示例：线性回归的 NumPy vs PyTorch"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:232
msgid "让我们用同一个问题（线性回归）对比两种实现，看看 PyTorch 如何简化代码："
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:234
msgid "NumPy 实现（手动梯度）"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:236
#, python-brace-format
msgid ""
"import numpy as np\n"
"\n"
"# 数据：y = 2x + 1 + noise\n"
"np.random.seed(42)\n"
"X = np.random.randn(100, 1)\n"
"y = 2 * X + 1 + np.random.randn(100, 1) * 0.1\n"
"\n"
"# 参数初始化\n"
"w = np.zeros((1, 1))\n"
"b = np.zeros(1)\n"
"\n"
"# 训练 100 步\n"
"lr = 0.1\n"
"for epoch in range(100):\n"
"    # 前向传播\n"
"    y_pred = X @ w + b\n"
"    \n"
"    # 计算损失\n"
"    loss = np.mean((y_pred - y) ** 2)\n"
"    \n"
"    # 手动计算梯度（需要推导公式！）\n"
"    # ∂L/∂w = 2 * X^T @ (y_pred - y) / n\n"
"    # ∂L/∂b = 2 * mean(y_pred - y)\n"
"    grad_w = 2 * X.T @ (y_pred - y) / len(X)\n"
"    grad_b = 2 * np.mean(y_pred - y)\n"
"    \n"
"    # 参数更新（梯度下降）\n"
"    w -= lr * grad_w\n"
"    b -= lr * grad_b\n"
"\n"
"print(f\"学习到的参数: w={w[0,0]:.3f}, b={b[0]:.3f}\")\n"
"# 应该接近 w=2, b=1\n"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:271
msgid "PyTorch 实现（自动微分）"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:273
#, python-brace-format
msgid ""
"import torch\n"
"\n"
"# 数据\n"
"torch.manual_seed(42)\n"
"X = torch.randn(100, 1)\n"
"y = 2 * X + 1 + torch.randn(100, 1) * 0.1\n"
"\n"
"# 参数：requires_grad=True 表示需要计算梯度\n"
"w = torch.zeros((1, 1), requires_grad=True)\n"
"b = torch.zeros(1, requires_grad=True)\n"
"\n"
"# 训练\n"
"lr = 0.1\n"
"for epoch in range(100):\n"
"    # 前向传播\n"
"    y_pred = X @ w + b\n"
"    \n"
"    # 计算损失\n"
"    loss = torch.mean((y_pred - y) ** 2)\n"
"    \n"
"    # 反向传播：自动计算所有梯度！\n"
"    loss.backward()\n"
"    \n"
"    # 参数更新\n"
"    with torch.no_grad():  # 更新时不需要计算梯度\n"
"        w -= lr * w.grad\n"
"        b -= lr * b.grad\n"
"        w.grad.zero_()  # 清空梯度，准备下一轮\n"
"        b.grad.zero_()\n"
"\n"
"print(f\"学习到的参数: w={w.item():.3f}, b={b.item():.3f}\")\n"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:307
msgid "对比分析"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:317
msgid "**核心洞察**：PyTorch 没有改变算法，只是自动化了机械性的梯度计算。"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:320
msgid "常见陷阱"
