#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:322
msgid "陷阱 1：原地修改张量"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:324
msgid ""
"x = torch.tensor([1.0, 2.0], requires_grad=True)\n"
"\n"
"# 错误：原地修改会破坏计算图\n"
"# x += 1  # 这会报错！\n"
"\n"
"# 正确：创建新张量\n"
"x = x + 1  # 这是安全的\n"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:334
msgid "陷阱 2：忘记清空梯度"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:336
msgid ""
"# 错误：梯度会累加！\n"
"for epoch in range(100):\n"
"    loss = compute_loss()\n"
"    loss.backward()\n"
"    # 如果不清空，w.grad 会累加所有轮次的梯度\n"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:344
msgid "陷阱 3：在梯度计算图中更新参数"
msgstr ""

#: ../../../source/pytorch-practice/from-numpy-to-pytorch.md:346
msgid ""
"# 错误：这会在计算图中记录参数更新操作\n"
"w = w - lr * w.grad  # 不要这样做！\n"
"\n"
"# 正确：用 torch.no_grad() 上下文\n"
"with torch.no_grad():\n"
"    w -= lr * w.grad\n"
msgstr ""

