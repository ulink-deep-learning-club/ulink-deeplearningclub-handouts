#: ../../../source/pytorch-practice/auto-grad.md:60
msgid "创建可追踪的张量"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:62
#, python-brace-format
msgid ""
"import torch\n"
"\n"
"# 叶子节点：requires_grad=True 告诉 PyTorch\"我要跟踪这个张量\"\n"
"x = torch.tensor([2.0, 3.0], requires_grad=True)  # 输入特征\n"
"w = torch.tensor([1.0, 2.0], requires_grad=True)  # 权重\n"
"b = torch.tensor(0.5, requires_grad=True)          # 偏置\n"
"\n"
"print(f\"x.is_leaf: {x.is_leaf}\")  # True：用户创建的叶子节点\n"
"print(f\"w.is_leaf: {w.is_leaf}\")  # True\n"
"\n"
"# 中间节点：通过运算产生\n"
"z = x * w              # 逐元素乘法，形状 [2]\n"
"y = z.sum() + b        # 求和后加偏置，标量\n"
"\n"
"print(f\"z.is_leaf: {z.is_leaf}\")  # False：运算产生\n"
"print(f\"y.is_leaf: {y.is_leaf}\")  # False\n"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:67
msgid "梯度计算：.backward() 的魔力"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:69
msgid "标量输出的梯度计算"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:71
#, python-brace-format
msgid ""
"import torch\n"
"\n"
"# 创建叶子节点\n"
"x = torch.tensor(2.0, requires_grad=True)  # 对应 back-propagation 中的示例\n"
"y = torch.tensor(3.0, requires_grad=True)\n"
"\n"
"# 前向传播：f = (x + y) × y\n"
"a = x + y      # a = 5\n"
"f = a * y      # f = 15\n"
"\n"
"print(f\"前向结果: f = {f.item()}\")  # 15.0\n"
"\n"
"# 反向传播：自动计算梯度\n"
"f.backward()\n"
"\n"
"# 查看梯度\n"
"print(f\"∂f/∂x = {x.grad}\")  # 3.0（与理论一致！）\n"
"print(f\"∂f/∂y = {y.grad}\")  # 8.0（与理论一致！）\n"
"\n"
"# 梯度验证（手工计算）：\n"
"# ∂f/∂x = ∂f/∂a × ∂a/∂x = y × 1 = 3 ✓\n"
"# ∂f/∂y = ∂f/∂a × ∂a/∂y + ∂f/∂y（直接） = y + a = 3 + 5 = 8 ✓\n"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:76
msgid "**代码解释**："
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:77
msgid "`requires_grad=True`：告诉 PyTorch 跟踪这个张量的所有操作"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:78
msgid "`.backward()`：从输出节点开始，沿计算图反向传播，计算所有叶子节点的梯度"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:79
msgid "`.grad`：存储计算得到的梯度值"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:81
msgid "非标量输出的处理"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:83
msgid "当输出不是标量时，需要指定权重向量："
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:85
#, python-brace-format
msgid ""
"import torch\n"
"\n"
"# 输出是向量而非标量\n"
"x = torch.tensor([1.0, 2.0, 3.0], requires_grad=True)\n"
"y = x * 2  # y = [2, 4, 6]\n"
"\n"
"# 错误：y 是向量，不能直接 backward()\n"
"# y.backward()  # RuntimeError!\n"
"\n"
"# 正确：提供一个权重向量（相当于计算 v^T × J）\n"
"# 这里我们计算 y 每个元素对 x 的梯度的加权和\n"
"v = torch.tensor([1.0, 1.0, 1.0])  # 权重向量\n"
"y.backward(v)  # 等价于计算 sum(y) 的梯度\n"
"\n"
"print(f\"x.grad = {x.grad}\")  # [2, 2, 2]\n"
"\n"
"# 实际应用：通常我们会将损失降为标量\n"
"loss = y.sum()  # 标量\n"
"loss.backward()  # 可以直接调用\n"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:107
msgid "梯度控制技巧"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:109
msgid "梯度累积与清零"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:111
msgid "**关键问题**：PyTorch 的 `.backward()` 默认会**累积**梯度！"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:113
#, python-brace-format
msgid ""
"import torch\n"
"\n"
"x = torch.tensor(2.0, requires_grad=True)\n"
"\n"
"# 第一次前向+反向\n"
"y1 = x ** 2      # y1 = 4\n"
"y1.backward()\n"
"print(f\"第一次反向后 x.grad = {x.grad}\")  # 4.0（dy1/dx = 2x = 4）\n"
"\n"
"# 第二次前向+反向（不清零）\n"
"y2 = x ** 3      # y2 = 8\n"
"y2.backward()\n"
"print(f\"第二次反向后 x.grad = {x.grad}\")  # 16.0！（4 + 12，累积了！）\n"
"\n"
"# 正确做法：每次反向前清零\n"
"x.grad.zero_()   # 清零梯度\n"
"y3 = x ** 2\n"
"y3.backward()\n"
"print(f\"清零后 x.grad = {x.grad}\")  # 4.0\n"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:118
msgid "**训练循环中的标准模式**："
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:120
msgid ""
"optimizer = torch.optim.SGD(model.parameters(), lr=0.01)\n"
"\n"
"for batch in dataloader:\n"
"    # 1. 清零旧梯度\n"
"    optimizer.zero_grad()  # 或 model.zero_grad()\n"
"    \n"
"    # 2. 前向传播\n"
"    output = model(batch.input)\n"
"    loss = criterion(output, batch.target)\n"
"    \n"
"    # 3. 反向传播\n"
"    loss.backward()\n"
"    \n"
"    # 4. 更新参数\n"
"    optimizer.step()\n"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:138
msgid "禁用梯度计算"
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:140
msgid "在某些情况下，我们不需要计算梯度："
msgstr ""

#: ../../../source/pytorch-practice/auto-grad.md:142
#, python-brace-format
msgid ""
"import torch\n"
"\n"
"x = torch.tensor(2.0, requires_grad=True)\n"
"\n"
"# 方式1：使用 torch.no_grad() 上下文管理器（推荐）\n"
"with torch.no_grad():\n"
"    y = x * 2\n"
"    print(f\"y.requires_grad: {y.requires_grad}\")  # False\n"
"    # y.backward()  # 错误！无法反向传播\n"
"\n"
"# 方式2：使用 .detach() 从计算图中分离\n"
"z = x * 3\n"
"z_detached = z.detach()\n"
"print(f\"z_detached.requires_grad: {z_detached.requires_grad}\")  # False"
"\n"
"\n"
"# 方式3：设置 requires_grad=False（全局）\n"
"w = torch.tensor(2.0, requires_grad=False)\n"
"output = w * x\n"
"print(f\"output.requires_grad: {output.requires_grad}\")  # True（x 需要梯度）\n"
msgstr ""

