msgstr ""

#: ../../../source/transfer-learning/part4-practical-guide.md:374
msgid "图像尺寸：原始1024×1024，预处理为224×224"
msgstr ""

#: ../../../source/transfer-learning/part4-practical-guide.md:376
msgid "**挑战**："
msgstr ""

#: ../../../source/transfer-learning/part4-practical-guide.md:377
msgid "数据量小（总计约5,000张）"
msgstr ""

#: ../../../source/transfer-learning/part4-practical-guide.md:378
msgid "类别不平衡（正常:肺炎 ≈ 1:3）"
