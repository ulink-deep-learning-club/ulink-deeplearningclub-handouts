#: ../../../source/transfer-learning/part3-model-transfer.md:79
msgid "策略一：特征提取器"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:81
msgid "**核心思想**：冻结预训练模型所有层，仅训练新的分类器。"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:83
msgid "**工作流程**："
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:85
#, python-brace-format
msgid ""
"import torchvision.models as models\n"
"import torch.nn as nn\n"
"\n"
"# 加载预训练模型（来自 ImageNet 训练的 ResNet50）\n"
"# 这些权重编码了边缘、纹理、形状等通用视觉特征\n"
"model = models.resnet50(weights='IMAGENET1K_V1')\n"
"\n"
"# 冻结所有层：requires_grad=False 表示不计算这些参数的梯度\n"
"# 这会\"锁定\"预训练知识，防止在训练中被改变\n"
"for param in model.parameters():\n"
"    param.requires_grad = False\n"
"\n"
"# 替换分类头：原模型输出 1000 类（ImageNet），替换为目标类别数\n"
"# 只有这一层是新初始化的，需要从头学习\n"
"num_features = model.fc.in_features  # 获取全连接层输入维度（ResNet50 是 2048）\n"
"model.fc = nn.Linear(num_features, num_classes)  # num_classes 是你的任务类别数\n"
"\n"
"# 优化器只传入新分类层的参数\n"
"# 见 {doc}`../pytorch-practice/optimiser` 中优化器参数设置\n"
"optimizer = torch.optim.Adam(model.fc.parameters(), lr=0.001)\n"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:108
#: ../../../source/transfer-learning/part3-model-transfer.md:372
msgid "**适用场景**："
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:109
msgid "✅ 目标数据集很小（<1000样本）"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:110
msgid "✅ 目标域与预训练域高度相似"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:111
msgid "✅ 需要快速原型验证"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:113
msgid "**优势**：训练快、不易过拟合、计算资源要求低"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:115
msgid "策略二：微调"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:117
msgid "**核心思想**：在预训练权重基础上继续训练，可微调全部或部分层。"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:119
msgid "全量微调"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:121
msgid ""
"import torchvision.models as models\n"
"import torch.nn as nn\n"
"\n"
"# 加载预训练模型\n"
"model = models.resnet50(weights='IMAGENET1K_V1')\n"
"\n"
"# 替换分类头为目标类别数\n"
"# 新分类层随机初始化，其他层保留预训练权重\n"
"model.fc = nn.Linear(model.fc.in_features, num_classes)\n"
"\n"
"# 所有参数参与训练（不冻结任何层）\n"
"# 学习率通常比从头训练小一个数量级（1e-4 vs 1e-3）\n"
"# 防止过大的更新破坏预训练知识\n"
"optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)\n"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:138
msgid "分层微调——不同层用不同\"学习速度\""
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:140
#: ../../../source/transfer-learning/part3-model-transfer.md:180
#: ../../../source/transfer-learning/part3-model-transfer.md:336
msgid "**直觉理解**："
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:142
msgid "想象你在学习开车（新任务），但你已经会骑自行车（预训练）。"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:144
msgid "**平衡感**（浅层）：骑车和开车都需要的技能 → 基本不用改"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:145
msgid "**转向控制**（中层）：原理相似但操作不同 → 稍微调整"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:146
msgid "**油门刹车**（深层）：全新的操作方式 → 重点学习"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:147
msgid "**交通规则**（分类层）：完全不同的知识 → 从头学起"
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:149
msgid "分层微调就是给不同层设置不同的\"学习速度\"："
msgstr ""

#: ../../../source/transfer-learning/part3-model-transfer.md:151
#, python-brace-format
msgid ""
"import torch.optim as optim\n"
"\n"
"# 分层学习率配置\n"
"# 原理：浅层（layer1-2）学习边缘/纹理等通用特征，应尽量保持不变\n"
"#      深层（layer3-4）学习物体部件等半通用特征，可适度调整\n"
"#      分类层（fc）完全针对新任务，需要大幅学习\n"
"optimizer = optim.Adam([\n"
"    {'params': model.layer1.parameters(), 'lr': 1e-5},  # 最浅层，最小学习率\n"
"    {'params': model.layer2.parameters(), 'lr': 1e-5},  # 浅层特征\n"
"    {'params': model.layer3.parameters(), 'lr': 1e-4},  # 中层特征\n"
"    {'params': model.layer4.parameters(), 'lr': 1e-4},  # 深层特征\n"
"    {'params': model.fc.parameters(), 'lr': 1e-3}       # 新分类层，最大学习率\n"
"])\n"
"\n"
"# 这种配置平衡了稳定性（浅层不变）和适应性（深层可调）\n"
"# 参见 {doc}`../pytorch-practice/optimiser` 中参数组配置\n"
msgstr ""

